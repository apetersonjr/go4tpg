# Template only — no real values belong in this file. It is the one canonical
# list of what production needs.
#
# Production: set these in the Dokploy dashboard, under the application's
# Environment tab. Dokploy injects them into the container at runtime. Do NOT
# write a .env.local on the server — the container is rebuilt from source on
# every deploy and anything on its filesystem is discarded.
#
# Local development: copy to .env.local and fill in. .env.local is gitignored.
#
# Never prefix any of these with NEXT_PUBLIC_. That inlines the value into the
# client bundle, where anyone can read it.

# SMTP (Google Workspace app password)
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=apeterson@go4tpg.com

# ClickUp
CLICKUP_API_TOKEN=
CLICKUP_LIST_ID=
CLICKUP_ASSIGNEE_ID=

# ---------------------------------------------------------------------------
# Scorecard widget
# ---------------------------------------------------------------------------
# The model that writes the acknowledgement lines and the reading. Server-side
# only — the widget never sees it. platform.openai.com -> API keys.
OPENAI_API_KEY=

# Single n8n webhook, fired twice per session (lead_started, lead_completed).
# n8n owns the Sheet row, the ClickUp task and the mail to Alan, so changing
# any of those is an edit in n8n rather than a redeploy of this site.
SCORECARD_WEBHOOK_URL=

# Optional. Enriches the company from the domain typed into the gate form, and
# lets a known headcount skip question 2. Everything still works without it.
APOLLO_API_KEY=
