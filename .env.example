# Template only — no real values belong in this file. It is the one canonical
# list of what production needs.
#
# Production: set these in the Dokploy dashboard, under the application's
# Environment tab. Dokploy injects them into the container at runtime. Do NOT
# write a .env.local on the server — the container is rebuilt from source on
# every deploy and anything on its filesystem is discarded.
#
# Local development: copy to .env.local and fill in. .env.local is gitignored.
#
# Never prefix any of these with NEXT_PUBLIC_. That inlines the value into the
# client bundle, where anyone can read it.

# Email. resend.com -> API keys. The sending domain must be verified in Resend
# before anything leaves the building, and MAIL_FROM has to sit on that domain.
RESEND_API_KEY=
# "Name <address@domain>" is accepted, and is what shows in Alan's inbox.
MAIL_FROM=
# Where berth notifications land. This is the intended value; the local .env
# and the Dokploy environment have been observed carrying a personal Gmail
# address instead. Confirm with Alan which is correct before changing either —
# a wrong value here silently sends leads to the wrong inbox.
MAIL_TO=apeterson@go4tpg.com

# ClickUp
CLICKUP_API_TOKEN=
CLICKUP_LIST_ID=
CLICKUP_ASSIGNEE_ID=

# ---------------------------------------------------------------------------
# Scorecard widget
# ---------------------------------------------------------------------------
# The model behind both scorecard calls: the per-turn engine that writes each
# question and extracts a structured reading, and the final analysis that
# writes the report. Server-side only — the widget never sees it.
# platform.openai.com -> API keys.
OPENAI_API_KEY=

# REQUIRED. Single n8n webhook, fired twice per session (lead_started,
# lead_completed). n8n owns the Sheet row, the ClickUp task, the mail to Alan
# and the visitor's PDF report, so changing any of those is an edit in n8n
# rather than a redeploy of this site.
#
# This one is not optional any more and the app enforces it. The scorecard now
# tells the visitor their report is emailed instantly, so a deploy without this
# breaks a promise made to their face — silently, because the widget would
# otherwise keep working. `src/instrumentation.ts` refuses to boot a production
# server when it is unset. If you hit that error, this is the variable to set.
SCORECARD_WEBHOOK_URL=

# REQUIRED. The shared secret the webhook is signed with. Sent as the
# `x-tpg-signature` header on every scorecard POST, for both events.
#
# This MUST be byte-for-byte the same value as TPG_SCORECARD_SECRET on the n8n
# instance. n8n's "Valid Request?" node compares the two and silently drops
# anything that does not match — into a dead-end branch, with no email, no
# Sheet row and no task, while this site still tells the visitor their report
# is on its way. So a mismatch is invisible from both ends. Rotating it is an
# edit in two places; doing only one of them loses every lead until it is
# noticed.
#
# `src/instrumentation.ts` refuses to boot a production server when this is
# unset, for the same reason it refuses without the URL above.
#
# Generate one with: openssl rand -hex 32
TPG_SCORECARD_SECRET=

# The webhook is signed but the endpoint is still public, so the URL remains
# worth protecting on its own: keep it out of tickets and screenshots, and
# rotate it in n8n if it leaks. The signature makes the endpoint safe to be
# found, not safe to be published.
#
# Use the PRODUCTION webhook path (`/webhook/...`), not the test one
# (`/webhook-test/...`). The test URL answers exactly one call after you press
# "Test workflow" in the n8n editor and returns 404 forever after, which
# surfaces here as "webhook rejected ... 404" and a silently lost lead.

# ---------------------------------------------------------------------------
# Report builder — POST /api/report/build
# ---------------------------------------------------------------------------
# The endpoint that assembles the visitor's personalized installation plan PDF
# and hands it back to n8n to email. It merges the nineteen one-pagers and the
# brochure with six pages generated per session.
#
# It is UNAUTHENTICATED — n8n posts to it with no credential, and so can anyone
# else who knows the path. Nothing to configure for that; it is noted here so
# the absence is a decision on record rather than an oversight.
#
# Optional. The booking link behind the "Book a 20-minute call" button on the
# closing page of every report. When unset the button is not drawn at all — a
# button that looks pressable and does nothing reads as a broken document — and
# the closing page falls back to the email address alone, which is always
# present. It never prints an empty slot or the word "undefined".
TPG_CALENDLY_URL=

# n8n's side of the same call: point TPG_REPORT_BUILDER_URL on the n8n instance
# at https://go4tpg.com/api/report/build. That is configuration on the n8n
# instance, not this app, and is listed here only so the pair is documented in
# one place. Note the endpoint responds to the path without a trailing slash
# via a 308 redirect; n8n must follow redirects, or be pointed at the exact
# path, or the POST body is dropped on the redirect.

# Optional. Set to 1 to log the exact payload sent to the analysis model. That
# payload contains signals and interpreted evidence only — never a visitor's
# raw answer — and logging it is how that guarantee is verified rather than
# assumed. On automatically outside production; leave unset in production
# unless you are actively checking, since it does log the contact's name and
# domain next to a business assessment.
SCORECARD_LOG_ANALYSIS_PAYLOAD=

# Optional. Enriches the company from the domain typed into the gate form, and
# lets a known headcount satisfy the headcount question without asking it.
# Everything still works without it.
APOLLO_API_KEY=
