# Template only — no real values belong in this file. It is the one canonical
# list of what production needs.
#
# Production: set these in the Dokploy dashboard, under the application's
# Environment tab. Dokploy injects them into the container at runtime. Do NOT
# write a .env.local on the server — the container is rebuilt from source on
# every deploy and anything on its filesystem is discarded.
#
# Local development: copy to .env.local and fill in. .env.local is gitignored.
#
# Never prefix any of these with NEXT_PUBLIC_. That inlines the value into the
# client bundle, where anyone can read it.

# SMTP (Google Workspace app password)
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=apeterson@go4tpg.com

# ClickUp
CLICKUP_API_TOKEN=
CLICKUP_LIST_ID=
CLICKUP_ASSIGNEE_ID=
